{
  "name": "react-web-spritez",
  "version": "1.0.52",
  "description": "An interactive floating pixel sprites for React websites",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/react-web-spritez.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist --rootDir src"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  }
}
